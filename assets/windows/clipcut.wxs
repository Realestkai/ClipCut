<?xml version="1.0" encoding="UTF-8"?>
<!--
  ClipCut's Windows Installer package, the .msi beside the Inno Setup .exe.

  Built by build-app.yml with WiX from the staged folder the .exe is made
  of, so the two installers ship the same files. The .exe is the
  one a person double-clicks; this is the one an administrator deploys -
  Group Policy, Intune, winget - and it installs for the machine, into
  Program Files, with a Start menu entry and a clean uninstall. Handed in:

    wix build -arch x64 -d Version=0.2.11 -d Root=C:\...\ClipCut
              -d Stage=C:\...\stage\ClipCut-0.2.11-windows-x86_64
              -o stage\ClipCut-0.2.11-windows-x86_64.msi assets\windows\clipcut.wxs

  Root is the repository: WiX resolves a source path against where it is
  run from, not against this file.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <!-- One upgrade code for the life of the product, so a newer .msi
       replaces an older one rather than sitting beside it. -->
  <Package Name="ClipCut"
           Manufacturer="ClipCut contributors"
           Version="$(var.Version)"
           UpgradeCode="9E568853-077D-4352-B2D6-76DA3B1FDEA6"
           Scope="perMachine"
           Language="1033">
    <MajorUpgrade DowngradeErrorMessage="A newer version of ClipCut is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="clipcut.ico" SourceFile="$(var.Root)\assets\icons\clipcut.ico" />
    <Property Id="ARPPRODUCTICON" Value="clipcut.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/Realestkai/ClipCut" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="ClipCut" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ShortcutFolder" Name="ClipCut" />
    </StandardDirectory>

    <Feature Id="Main" Title="ClipCut" Level="1">
      <ComponentGroupRef Id="Program" />
      <ComponentRef Id="StartMenu" />
    </Feature>

    <!-- Every file in the staged folder, as it is there. -->
    <ComponentGroup Id="Program" Directory="INSTALLFOLDER">
      <Files Include="$(var.Stage)\**" />
    </ComponentGroup>

    <Component Id="StartMenu" Directory="ShortcutFolder" Guid="A1A78020-AECC-48AE-B446-9FBA2EEE1E90">
      <Shortcut Id="StartMenuShortcut"
                Name="ClipCut"
                Description="Video editor"
                Target="[INSTALLFOLDER]clipcut.exe"
                WorkingDirectory="INSTALLFOLDER"
                Icon="clipcut.ico" />
      <!-- The way in when a graphics driver draws the window as coloured
           squares: it turns off Settings > General > Draw on the GPU,
           which that window hides. -->
      <Shortcut Id="SafeGraphicsShortcut"
                Name="ClipCut (safe graphics)"
                Description="ClipCut, drawn in software"
                Target="[INSTALLFOLDER]clipcut.exe"
                Arguments="--software"
                WorkingDirectory="INSTALLFOLDER"
                Icon="clipcut.ico" />
      <RemoveFolder Id="RemoveShortcutFolder" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\ClipCut" Name="StartMenu" Type="integer" Value="1" KeyPath="yes" />
    </Component>
  </Package>
</Wix>
