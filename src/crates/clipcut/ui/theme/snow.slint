// Snow: soft flakes drifting down over the whole window, under any look,
// while Settings > Appearance's Snow switch is on (Theme.snow).
//
// Drawn, not played: each flake's place is worked out from the clock and
// its own number, so there is no state to keep and nothing to load. Three
// depths - small slow faint flakes far off, larger quicker brighter ones
// near - and each sways a little as it falls. Nothing here takes a click:
// the layer lies over the window and every press goes through it.
import { Theme } from "theme.slint";

export component Snow inherits Rectangle {
    /// How many flakes: enough to read as snow on a large window, few
    /// enough that it never covers the work.
    in property <int> count: 90;

    /// Seconds since the layer appeared.
    property <float> t: animation-tick() / 1s;
    /// The flakes' colour: white on Dark, a cool grey-blue on Light, where
    /// white would vanish into the page.
    property <color> ink: Theme.dark ? #ffffff : #9fb3cc;

    for i in root.count: Rectangle {
        // Two fixed fractions a flake, spread evenly by the golden ratio
        // and its square, so no two flakes share a lane or a phase.
        property <float> a: (i * 0.6180339887) - Math.floor(i * 0.6180339887);
        property <float> b: (i * 0.7548776662 + 0.31) - Math.floor(i * 0.7548776662 + 0.31);
        /// 0 far, 1 middle, 2 near.
        property <int> depth: i - Math.floor(i / 3) * 3;
        property <length> size: (self.depth == 0 ? 2.2px : self.depth == 1 ? 3.4px : 4.8px) * (0.8 + 0.4 * self.b);
        /// Window heights a second.
        property <float> speed: (self.depth == 0 ? 0.035 : self.depth == 1 ? 0.055 : 0.08) * (0.8 + 0.5 * self.b);
        property <float> fall: (self.a + root.t * self.speed) - Math.floor(self.a + root.t * self.speed);

        x: self.b * (root.width + 40px) - 20px
            + Math.sin((root.t * (0.6 + 0.5 * self.a) + i * 1.7) * 1rad) * (8px + self.depth * 6px);
        y: self.fall * (root.height + 24px) - 12px;
        width: self.size;
        height: self.size;
        border-radius: self.size / 2;
        background: @radial-gradient(circle, root.ink 0%, root.ink 45%, root.ink.with-alpha(0) 100%);
        opacity: self.depth == 0 ? 0.35 : self.depth == 1 ? 0.55 : 0.8;
    }
}
